// Serwer pośredniczący Songstera (Cloudflare Workers + Durable Objects, plan darmowy).
// Wdrożenie: instrukcja w server/relay/README.md (Workers Builds z repozytorium, katalog główny: server/relay).
{
  "name": "songster-relay",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  // strony, które mogą korzystać z serwera (adres gry; localhost – testy i uruchomienie lokalne)
  "vars": { "ALLOWED_ORIGINS": "https://matyz55.github.io" },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // plan darmowy: tylko Durable Objects z pamięcią SQLite
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
